
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>only for you ♡</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap');

:root {
  --pink:#f8dce6;
  --light:#fff5f7;
  --rose:#e8a8bc;
  --dark:#79495b;
  --text:#795968;
  --white:#fffdfd;
}

* {box-sizing:border-box}

html {scroll-behavior:smooth}

body {
  margin:0;
  background:var(--light);
  color:var(--text);
  font-family:'DM Sans',sans-serif;
  overflow-x:hidden;
}

button {font-family:inherit;cursor:pointer}

#floaties {
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:20;
  overflow:hidden;
}

.float {
  position:absolute;
  bottom:-30px;
  animation:rise linear forwards;
  opacity:.65;
}

@keyframes rise {
  to {transform:translateY(-110vh) rotate(45deg);opacity:0}
}

.page {
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:25px 18px;
}

.card {
  width:min(540px,100%);
  background:rgba(255,255,255,.8);
  border:1px solid #f4dce4;
  border-radius:32px;
  padding:45px 25px;
  text-align:center;
  box-shadow:0 20px 65px #eacbd650;
}

.eyebrow {
  text-transform:uppercase;
  letter-spacing:3px;
  font-size:10px;
  color:#b78398;
}

h1,h2,h3 {
  font-family:'Playfair Display',serif;
  font-weight:400;
}

h1 {
  font-size:clamp(48px,12vw,76px);
  color:var(--dark);
  margin:25px 0 12px;
}

h2 {
  font-size:clamp(35px,9vw,52px);
  color:var(--dark);
  line-height:1.15;
}

h3 {font-size:25px}

p {line-height:1.85}

.intro {
  max-width:370px;
  margin:15px auto 28px;
  color:#987889;
  font-size:14px;
}

.btn {
  border:0;
  border-radius:40px;
  background:#b96f8b;
  color:white;
  padding:15px 25px;
  font-size:11px;
  letter-spacing:1.5px;
  text-transform:uppercase;
  box-shadow:0 8px 20px #e5b9c9;
  transition:.25s;
}

.btn:hover {transform:translateY(-3px)}

.btn.light {
  background:#f8e5eb;
  color:#87576a;
  box-shadow:none;
  border:1px solid #eed1dc;
}

#inside {display:none}

.section {
  width:min(650px,90%);
  margin:auto;
  padding:75px 0;
}

.center {text-align:center}

.tag {
  display:inline-block;
  padding:8px 14px;
  background:#f8e5eb;
  color:#a56881;
  border-radius:30px;
  font-size:10px;
  letter-spacing:1.5px;
  text-transform:uppercase;
}

.muted {color:#a18291;font-size:14px}

.heartline {
  color:#dfa5b8;
  letter-spacing:10px;
  margin:25px 0;
}

.chat {
  display:flex;
  flex-direction:column;
  gap:12px;
  margin-top:30px;
  text-align:left;
}

.msg {
  max-width:88%;
  padding:17px 19px;
  border-radius:20px 20px 20px 5px;
  background:white;
  border:1px solid #f2dfe6;
  font-size:14px;
  line-height:1.7;
  opacity:0;
  transform:translateY(10px);
  transition:.5s;
}

.msg.right {
  align-self:flex-end;
  background:#f7e3e9;
  border-radius:20px 20px 5px 20px;
}

.msg.visible {
  opacity:1;
  transform:none;
}

.msg small {
  display:block;
  font-size:9px;
  color:#b18497;
  letter-spacing:1.5px;
  margin-bottom:7px;
}

.timeline {
  display:grid;
  gap:15px;
  margin-top:30px;
}

.event {
  background:white;
  border:1px solid #f1dce4;
  border-radius:22px;
  padding:22px;
}

.event small {
  color:#b27a91;
  letter-spacing:2px;
  font-size:10px;
  text-transform:uppercase;
}

.event h3 {margin:10px 0;color:#805267}

.event p {
  font-size:13px;
  margin:0;
  color:#967987;
}

.love-grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin-top:28px;
}

.love-card {
  min-height:125px;
  padding:20px 14px;
  background:white;
  border:1px solid #efd9e2;
  border-radius:22px;
  color:#85566b;
  text-align:center;
  transition:.3s;
}

.love-card:hover {background:#fae8ee;transform:translateY(-3px)}

.love-card strong {
  display:block;
  font-family:'Playfair Display',serif;
  font-size:19px;
  font-weight:400;
}

.love-card span {
  display:block;
  font-size:12px;
  line-height:1.6;
  margin-top:12px;
  color:#9d7889;
}

.quiz {
  background:white;
  border:1px solid #efdce3;
  border-radius:25px;
  padding:25px;
  margin-top:25px;
}

.answers {
  display:grid;
  gap:10px;
  margin-top:20px;
}

.answer {
  background:#fff8fa;
  border:1px solid #efd6e0;
  border-radius:14px;
  padding:14px;
  color:#80576a;
  text-align:left;
  font-size:13px;
}

.answer:disabled {opacity:.7}

#feedback {
  min-height:35px;
  color:#a45d7a;
  font-size:13px;
  margin-top:15px;
}

.song {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  padding:17px;
  margin:10px 0;
  background:white;
  border:1px solid #f0dce4;
  border-radius:17px;
}

.song b {
  font-family:'Playfair Display',serif;
  font-size:17px;
  font-weight:400;
}

.song small {
  display:block;
  font-size:11px;
  color:#a48794;
  margin-top:5px;
}

.song a {
  color:#a45d7a;
  font-size:10px;
  text-decoration:none;
}

.letter {
  background:#fffdfc;
  border:1px solid #efd6e0;
  box-shadow:0 15px 40px #eacbd650;
  border-radius:22px;
  padding:25px;
  text-align:left;
  line-height:1.9;
  display:none;
  margin-top:25px;
  animation:appear .5s;
}

.letter.open {display:block}

@keyframes appear {
  from {opacity:0;transform:translateY(10px)}
  to {opacity:1;transform:translateY(0)}
}

.envelope {
  display:block;
  margin:30px auto;
  width:150px;
  height:105px;
  border:1px solid #dfa9bc;
  border-radius:12px;
  background:#f3cedb;
  color:#965a73;
  font-size:37px;
  box-shadow:0 12px 25px #e8c5d2;
}

.final-box {
  display:none;
  background:#fff;
  border:1px solid #efd6e0;
  border-radius:22px;
  padding:28px;
  margin-top:25px;
  animation:appear .5s;
  font-family:'Playfair Display',serif;
  font-size:22px;
  line-height:1.7;
}

footer {
  text-align:center;
  padding:40px 15px 60px;
  color:#b38c9b;
  font-size:10px;
  letter-spacing:2px;
}

@media(max-width:450px) {
  .love-grid {grid-template-columns:1fr}
  .section {padding:55px 0}
}
</style>
</head>

<body>

<div id="floaties"></div>

<!-- OPENING -->
<section class="page" id="welcome">
  <div class="card">
    <div class="eyebrow">a little something for my person ♡</div>
    <h1>hello,<br><i>my Adii.</i></h1>
    <p class="intro">
      I could've written you another letter.
      But apparently, I decided to build you an entire
      corner of the internet instead.
    </p>
    <button class="btn" onclick="enter()">open your little surprise ♡</button>
    <p class="muted" style="font-size:11px;margin-top:22px">
      made with love, excessive pink and absolutely no chill.
    </p>
  </div>
</section>

<main id="inside">

<!-- INTRO -->
<section class="section center">
  <span class="tag">19 · 11 · 2026</span>
  <h2>five months.<br><i>five months of us.</i></h2>
  <p class="muted">
    If somebody had told me that the green jacket boy
    would become this important, I probably wouldn't have believed them.
  </p>
  <div class="heartline">♡ ♡ ♡</div>
  <button class="btn light" onclick="revealChat()">okay, read your messages</button>

  <div class="chat" id="chat">
    <div class="msg">
      <small>YOUR GIRL · 01</small>
      Happy five months, Buddy. First of all, congratulations
      on tolerating me for this long.
    </div>
    <div class="msg right">
      <small>YOUR GIRL · 02</small>
      Secondly, I hope you know how many ordinary moments
      become special just because you're part of them.
    </div>
    <div class="msg">
      <small>YOUR GIRL · 03</small>
      I miss our random conversations, the unnecessary
      gossip and all the little things that make us us.
    </div>
    <div class="msg right">
      <small>YOUR GIRL · 04</small>
      And lastly, I love you. Now don't get too proud,
      2foot. Your ego is already a full-time problem.
    </div>
  </div>
</section>

<!-- OUR STORY -->
<section class="section">
  <div class="center">
    <span class="tag">the lore</span>
    <h2>how did we<br><i>get here?</i></h2>
    <p class="muted">A very brief history of two very unserious people.</p>
  </div>

  <div class="timeline">
    <article class="event">
      <small>2019 · the beginning</small>
      <h3>The green jacket.</h3>
      <p>
        One first impression. One boy in a green jacket.
        Neither of us knew this would become a whole story.
      </p>
    </article>

    <article class="event">
      <small>2024 · the conversations</small>
      <h3>Just one more message.</h3>
      <p>
        A random conversation turned into late-night talks,
        friendship and a thousand things to discuss.
      </p>
    </article>

    <article class="event">
      <small>19 June 2026 · 12:59 AM</small>
      <h3>The plot twist.</h3>
      <p>
        The little sentence that changed the entire story.
        Suddenly, it wasn't just friendship anymore.
      </p>
    </article>

    <article class="event">
      <small>19 November 2026 · today</small>
      <h3>Five months of you and me.</h3>
      <p>
        Different routines, more distance, new chapters.
        But still our story, still our little world.
      </p>
    </article>
  </div>
</section>

<!-- LOVE NOTES -->
<section class="section center">
  <span class="tag">things i never get tired of</span>
  <h2>little things<br><i>about you.</i></h2>
  <p class="muted">Tap each one. I've been keeping these thoughts.</p>

  <div class="love-grid">
    <button class="love-card" onclick="toggle(this)">
      <strong>your eyes ♡</strong>
      <span hidden>Honestly, I could write an entire paragraph about them. But I'll spare you today.</span>
    </button>

    <button class="love-card" onclick="toggle(this)">
      <strong>your smile ♡</strong>
      <span hidden>One of those little things that stays in my mind long after I've seen it.</span>
    </button>

    <button class="love-card" onclick="toggle(this)">
      <strong>your voice ♡</strong>
      <span hidden>Even a random voice note can make an ordinary day feel a little less ordinary.</span>
    </button>

    <button class="love-card" onclick="toggle(this)">
      <strong>your nonsense ♡</strong>
      <span hidden>Buddy, Bhondu, Adii, 2foot. I swear we need an official dictionary.</span>
    </button>

    <button class="love-card" onclick="toggle(this)">
      <strong>your little updates ♡</strong>
      <span hidden>I love hearing about the smallest, most random parts of your day.</span>
    </button>

    <button class="love-card" onclick="toggle(this)">
      <strong>just you ♡</strong>
      <span hidden>Not because you're perfect. Just because you're you.</span>
    </button>
  </div>
</section>

<!-- QUIZ -->
<section class="section">
  <div class="center">
    <span class="tag">a very important test</span>
    <h2>do you even<br><i>know your girl?</i></h2>
    <p class="muted">No cheating, mister. I'm watching.</p>
  </div>

  <div class="quiz">
    <div class="eyebrow" id="number">QUESTION 01 / 03</div>
    <h3 id="question">What can make me talk for hours?</h3>
    <div class="answers" id="answers">
      <button class="answer" onclick="choose(0)">Random gossip</button>
      <button class="answer" onclick="choose(1)">Deep conversations</button>
      <button class="answer" onclick="choose(2)">Both, obviously.</button>
    </div>
    <div id="feedback"></div>
    <button class="btn light" id="next" style="display:none" onclick="next()">next question →</button>
  </div>
</section>

<!-- SOUNDTRACK -->
<section class="section">
  <div class="center">
    <span class="tag">press play, think of us</span>
    <h2>if our story<br><i>had a soundtrack.</i></h2>
    <p class="muted">Five songs. Five months. A few feelings.</p>
  </div>

  <div class="song">
    <div><b>Heeriye</b><small>Jasleen Royal · warm feelings</small></div>
    <a href="https://open.spotify.com/search/Heeriye" target="_blank">LISTEN ↗</a>
  </div>

  <div class="song">
    <div><b>I Like Me Better</b><small>Lauv · the happy kind of love</small></div>
    <a href="https://open.spotify.com/search/I%20Like%20Me%20Better" target="_blank">LISTEN ↗</a>
  </div>

  <div class="song">
    <div><b>Kho Gaye Hum Kahan</b><small>Prateek Kuhad · nostalgia</small></div>
    <a href="https://open.spotify.com/search/Kho%20Gaye%20Hum%20Kahan" target="_blank">LISTEN ↗</a>
  </div>

  <div class="song">
    <div><b>Until I Found You</b><small>Stephen Sanchez · old-school romance</small></div>
    <a href="https://open.spotify.com/search/Until%20I%20Found%20You" target="_blank">LISTEN ↗</a>
  </div>

  <div class="song">
    <div><b>Husn</b><small>Anuv Jain · quiet feelings</small></div>
    <a href="https://open.spotify.com/search/Husn" target="_blank">LISTEN ↗</a>
  </div>
</section>

<!-- LETTER -->
<section class="section center">
  <span class="tag">something i saved for last</span>
  <h2>psst...<br><i>one more thing.</i></h2>
  <p class="muted">
    There's a letter here. And no, you cannot skip it.
  </p>

  <button class="envelope" onclick="letter()">♡</button>

  <div class="letter" id="letter">
    <div class="eyebrow">to my favourite human</div>

    <h3>Dear Adii,</h3>

    <p>
      Five months. It sounds like such a small amount of time
      when I say it out loud, but somehow you've become part
      of so many things I never want to take for granted.
    </p>

    <p>
      Sometimes I wish I could pause the little moments:
      our random conversations, the laughter, the voice notes,
      the silly arguments and all the things that probably
      seem insignificant to everyone else.
    </p>

    <p>
      I know things are different now. We have our own routines
      and distance between us, but I don't want distance to
      make us forget the little things. I still want to hear
      about your day, tell you about mine and keep finding
      reasons to laugh together.
    </p>

    <p>
      Thank you for being part of my story.
      Thank you for the memories we've made and the ones
      we haven't even imagined yet.
    </p>

    <p>
      I don't need every day to be perfect.
      I just hope we keep being honest, patient and
      intentional with each other.
    </p>

    <p>
      Happy five months, my Bhondu.
      Here's to all the pages still waiting for us.
    </p>

    <h3 style="color:#a45e7b">
      I love you. ♡
    </h3>

    <p style="text-align:right;font-style:italic">
      — your Iram
    </p>
  </div>
</section>

<!-- ENDING -->
<section class="section center">
  <span class="tag">your final assignment</span>
  <h2>one last<br><i>little surprise.</i></h2>

  <p class="muted">
    You've reached the end. I'm impressed.
    Here's your reward.
  </p>

  <button class="btn" onclick="final()">click me, bhondu ♡</button>

  <div class="final-box" id="final">
    Five months down.<br>
    A lifetime of kalesh to go.<br><br>

    Your girlfriend subscription has been renewed
    automatically.<br>
    No cancellation. No refunds.<br><br>

    <span style="color:#bd7892">Love you, idiot. ♡</span>
  </div>
</section>

<footer>
MADE WITH LOVE, TOO MANY FEELINGS & A LOT OF PINK
<br><br>
IRAD · 19.06.2026 — 19.11.2026 ♡
</footer>

</main>

<script>
function enter(){
  document.getElementById('welcome').style.display='none';
  document.getElementById('inside').style.display='block';
  window.scrollTo(0,0);
  hearts(15);
}

function hearts(n=5){
  const area=document.getElementById('floaties');

  for(let i=0;i<n;i++){
    const el=document.createElement('span');
    el.className='float';
    el.textContent=['♡','♥','✧','୨୧'][Math.floor(Math.random()*4)];
    el.style.left=Math.random()*100+'%';
    el.style.fontSize=(13+Math.random()*18)+'px';
    el.style.animationDuration=(5+Math.random()*5)+'s';
    area.appendChild(el);
    setTimeout(()=>el.remove(),10000);
  }
}

setInterval(()=>{
  if(document.visibilityState==='visible') hearts(1);
},2500);

function revealChat(){
  document.querySelectorAll('.msg').forEach((el,i)=>{
    setTimeout(()=>el.classList.add('visible'),i*850);
  });
}

function toggle(button){
  const span=button.querySelector('span');
  span.hidden=!span.hidden;
  hearts(3);
}

const questions=[
 {
  q:"What can make me talk for hours?",
  a:["Random gossip","Deep conversations","Both, obviously."],
  correct:2,
  good:"Correct. You know your girl. ♡",
  bad:"Wrong answer. We need to revise your syllabus."
 },
 {
  q:"Which nickname do you hear from me?",
  a:["Buddy","Bhondu","All of them. Obviously."],
  correct:2,
  good:"Fluent in Iram-ese. Excellent.",
  bad:"Have you even been paying attention, sir?"
 },
 {
  q:"What matters most in a relationship?",
  a:["Being perfect","Expensive gifts","Honesty, effort and little things"],
  correct:2,
  good:"That's the answer. Keep that one forever. ♡",
  bad:"Nice try. Think about what actually matters."
 }
];

let current=0;

function render(){
  document.getElementById('number').textContent=
  'QUESTION 0'+(current+1)+' / 03';

  document.getElementById('question').textContent=
  questions[current].q;

  document.getElementById('answers').innerHTML=
  questions[current].a.map((answer,i)=>
    `<button class="answer" onclick="choose(${i})">${answer}</button>`
  ).join('');

  document.getElementById('feedback').textContent='';
  document.getElementById('next').style.display='none';
}

function choose(index){
  const q=questions[current];

  document.querySelectorAll('.answer').forEach(btn=>{
    btn.disabled=true;
  });

  document.getElementById('feedback').textContent=
    index===q.correct?q.good:q.bad;

  document.getElementById('next').style.display='inline-block';
  hearts(4);
}

function next(){
  current++;

  if(current<questions.length){
    render();
  }else{
    document.getElementById('number').textContent='TEST COMPLETED';
    document.getElementById('question').textContent=
      'Results are in.';

    document.getElementById('answers').innerHTML='';
    document.getElementById('feedback').textContent=
      'Certified Bhondu. Very loved. ♡';

    document.getElementById('next').style.display='none';
  }
}

function letter(){
  document.getElementById('letter').classList.toggle('open');
  hearts(12);
}

function final(){
  document.getElementById('final').style.display='block';
  hearts(20);
}
</script>

</body>
</html>
